+                SessionCloseInfo {
+                    close_code: code.unwrap_or(0),
+                    reason,
+                }
+            }
+            Some(crate::error::WebTransportError::SessionClosedLocally) => SessionCloseInfo {
+                close_code: 0,
+                reason: String::new(),
+            },
+            Some(error) => SessionCloseInfo {
+                close_code: 0,
+                reason: error.to_string(),
+            },
